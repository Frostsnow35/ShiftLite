# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ── 模型权重与中间产物：体积大，不入库 ──
# 运行 `python cli.py setup` 会自动下载并重建
artifacts/models/
*.pth
*.onnx
*.xml
*.bin

# ── 数据集与校准集 ──
*.zip
*.tar.gz
artifacts/calib/
artifacts/samples/
artifacts/eval/
artifacts/uploads/

# ── 推理与评测的图片产物（JSON/脚本/质量表保留，PNG 不入库）──
artifacts/results/inference/
artifacts/results/quality/
artifacts/results/anomalies/*.png
artifacts/results/_*
artifacts/figures/*.png

# ── 编辑器 / 系统 ──
.vscode/
.idea/
.DS_Store
Thumbs.db
~$*

# ── 临时文件 ──
*.tmp
*.bak
*.log
