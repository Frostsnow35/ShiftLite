# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ── 模型权重与中间产物：体积大，不入库 ──
# 运行 `python cli.py setup` 会自动下载并重建
artifacts/models/
*.pth
*.onnx
*.xml
*.bin

# ── 数据集与校准集 ──
*.zip
*.tar.gz
artifacts/calib/
artifacts/samples/
artifacts/eval/
artifacts/uploads/

# ── 推理与评测的图片产物（JSON/脚本/质量表保留，PNG 不入库）──
artifacts/results/inference/
artifacts/results/quality/
artifacts/results/anomalies/*.png
artifacts/results/structure_review/*.png
artifacts/results/_*
artifacts/figures/*.png

# ── 非默认迁移对的中间产物（artifacts/<pair>/…）──
# 只保留 results/ 下的 JSON 证据（benchmark/quality/layers），
# 权重、数据集、样例、校准集、推理图一律不入库，setup 可再生。
artifacts/*/models/
artifacts/*/calib/
artifacts/*/samples/
artifacts/*/eval/
artifacts/*/uploads/
artifacts/*/results/inference/
artifacts/*/results/quality/
artifacts/*/results/anomalies/*.png
artifacts/*/results/_*
artifacts/*/*.zip

# ── 编辑器 / 系统 ──
.vscode/
.idea/
.DS_Store
Thumbs.db
~$*

# ── 临时文件 ──
*.tmp
*.bak
*.log
# 分段下载的中间分片（xxx.part0 / xxx.part1 …）
*.part*
